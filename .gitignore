# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfplan
.terraformrc
terraform.rc

# Sensitive/local Terraform values
*.tfvars
*.tfvars.json
backend.hcl
*.backend.hcl

# Safe examples may be committed
!*.tfvars.example
!*.tfvars.json.example
!backend.hcl.example
!*.backend.hcl.example

# Keys and certificates
*.pem
*.key
*.pfx
*.p12
*.cer
*.crt
*.csr
*.ovpn

# Environment files
.env
.env.*
!.env.example

# Azure / local auth artefacts
.azure/

# Editors / OS
.vscode/settings.local.json
.DS_Store
Thumbs.db

# Temporary evidence/output
**/evidence/tmp/
*.log

# Intentionally tracked Terraform dependency lock file
# .terraform.lock.hcl is NOT ignored.
