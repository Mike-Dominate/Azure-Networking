# Optional Lab 03 variable overrides.
#
# Copy this file to terraform.tfvars only if you want to override defaults.
# The defaults already match the validated manual build, so this file is mainly
# here to demonstrate the normal Terraform pattern used across the programme.

location            = "australiaeast"
resource_group_name = "rg-az700-ip-aue"
vnet_name           = "vnet-az700-ip-aue"
vnet_address_space  = ["10.30.0.0/16"]

